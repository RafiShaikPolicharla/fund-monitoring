# DevOps reference only. Do not put real secrets in this file.
# Add production values in Vercel Project Settings -> Environment Variables.

AGENTFLOW_API_BASE_URL=
AGENTFLOW_API_KEY=

# Supabase is used by the original seeded/mock data path and as fallback
# when Agentflow is unavailable or returns no usable rows.
# These are browser-side Vite variables. The publishable key is expected
# to be safe for frontend use when Supabase RLS/policies are configured.
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Static prompt text is not secret, so VITE_ is fine.
VITE_ALERT_QUEUE_QUERY=Populate the alert queue
VITE_FUND_UNIVERSE_QUERY=Get the list of all approved funds

# Local development alternative:
# The current app also supports these VITE_ names in .env.local if needed.
# VITE_AGENTFLOW_API_BASE_URL=
# VITE_AGENTFLOW_API_KEY=
